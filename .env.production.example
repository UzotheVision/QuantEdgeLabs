# QuantEdge — production environment
# Copy the KEYS, never the values, into your host's secret manager.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/postgres
SESSION_SECRET=            # 64+ random bytes. Rotating it logs everyone out.
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# ── Tier roles ──────────────────────────────────────────────────────────────
# Set ONLY on the web service. Tells web that a worker owns background jobs so
# the two tiers stop running the same schedules. Omit it if you deploy web
# alone — web then takes the scheduler lock itself.
WORKER_ENABLED=true

# Belt and braces for the same thing on the web tier.
DISABLE_WEB_FLOW_CRON=1

# Escape hatches (leave unset normally):
#   DISABLE_SCHEDULERS=true   this process runs no background jobs at all
#   SCHEDULER_LOCK=off        skip the advisory lock (single instance ONLY)

# ── Connection pool ─────────────────────────────────────────────────────────
# Must stay under the provider's ceiling ACROSS ALL INSTANCES. Supabase's
# pooler caps at 15, so 2 web + 1 worker at 12 each would exceed it — size it
# as (cap - 2) / instance_count. See server/db.ts.
DB_POOL_MAX=12

# ── Market data ─────────────────────────────────────────────────────────────
POLYGON_API_KEY=
FINNHUB_API_KEY=
TRADIER_API_KEY=
TRADIER_ACCOUNT_ID=
TRADIER_USE_SANDBOX=false
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ── TradingView webhook (validation + paper only) ──────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=
INDEX_0DTE_ACCOUNT_SIZE=10000
INDEX_0DTE_RISK_BUDGET=250
INDEX_0DTE_MAX_DEBIT=300
